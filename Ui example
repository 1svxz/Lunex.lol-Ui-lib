-- ===== RIGHT GROUP =====
local visRight = vis:Group("Effects", "right")

visRight:Checkbox("Bloom", false, function(val)
    print("✅ Bloom:", val)
end, nil, "bloom")

visRight:Checkbox("Chromatic Aberration", true, function(val)
