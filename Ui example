-- ============================================================
-- LUNEX UI - MOBILE FRIENDLY (with inline color pickers)
-- ============================================================

local Lunex = loadstring(game:HttpGet("https://raw.githubusercontent.com/1svxz/Lunex.lol-Ui-lib/main/Lunex.lua"))()

local win = Lunex:Window({
    Size = Vector2.new(380, 480),  -- even smaller for mobile
    TitleLeft = "Cheat ",
    TitleRight = "v1.0"
})

-- ============================================================
-- TAB 1: AIM
-- ============================================================
local aim = win:Tab("Aim")

local aa = aim:Group("Aim Assist", "left")
aa:CheckboxKeybind("Aim Assist", true, Enum.KeyCode.Q, nil, "aim_enabled")
aa:TextBox("X Pred", "0.5", nil, "aim_x_pred")
aa:TextBox("Y Pred", "0.3", nil, "aim_y_pred")
aa:Combo("Target", {"Namecall","Index","Raycast"}, 1, nil, "aim_target")
aa:Checkbox("Resolver", false, nil, nil, "aim_resolver")

local sa = aim:Group("Silent Aim", "right")
sa:CheckboxKeybind("Silent Aim", false, Enum.KeyCode.E, nil, "silent_enabled")
sa:TextBox("X Pred", "0.7", nil, "silent_x_pred")
sa:TextBox("Y Pred", "0.4", nil, "silent_y_pred")
sa:Combo("Target", {"Namecall","Index","Raycast"}, 1, nil, "silent_target")
sa:Checkbox("Resolver", true, nil, nil, "silent_resolver")

-- ============================================================
-- TAB 2: ESP (toggle + color picker on each line!)
-- ============================================================
local esp = win:Tab("ESP")

local espGroup = esp:Group("ESP", "left")

-- Each checkbox has a color swatch beside it
espGroup:Checkbox("ESP Toggle", true, nil, nil, "esp_enabled")

espGroup:Checkbox("Name ESP", true, nil, {
    colors = {
        {default = Color3.fromRGB(255,255,255), flag = "esp_name_color"}
    }
}, "esp_name")

espGroup:Checkbox("Tracer ESP", true, nil, {
    colors = {
        {default = Color3.fromRGB(0,255,0), flag = "esp_tracer_color"}
    }
}, "esp_tracer")

espGroup:Checkbox("Box ESP", false, nil, {
    colors = {
        {default = Color3.fromRGB(255,0,0), flag = "esp_box_color"}
    }
}, "esp_box")

espGroup:Checkbox("Distance ESP", true, nil, {
    colors = {
        {default = Color3.fromRGB(255,255,0), flag = "esp_distance_color"}
    }
}, "esp_distance")

espGroup:Checkbox("Health ESP", true, nil, {
    colors = {
        {default = Color3.fromRGB(0,255,0), flag = "esp_health_color"}
    }
}, "esp_health")

-- ============================================================
-- TAB 3: CONFIG
-- ============================================================
local cfg = win:Tab("Config")

Lunex:CreateConfigManager(cfg, "left")
Lunex:CreateThemeManager(cfg, "right")
Lunex:CreateUICustomization(cfg, "left")  -- stacks under config

-- ============================================================
-- WATERMARK & TOGGLE
-- ============================================================
Lunex:CreateWatermark({ leftText = "Cheat", rightText = "v1.0" })
Lunex:BindToggle(win)
Lunex:CheckAutoLoad()

print("✅ Mobile UI loaded – Press Insert to toggle")
