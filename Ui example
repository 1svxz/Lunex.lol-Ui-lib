visRight:Combo("Visual Quality", {"Low", "Medium", "High", "Ultra"}, 3, function(idx, text)
    print("✅ Quality:", text)
end, "visual_quality")

-- ============================================================
-- TAB 3: CONFIG
-- ============================================================
local cfg = win:Tab("Config")

-- ===== LEFT GROUP: Configs =====
local cfgLeft = cfg:Group("Config Management", "left")

local cfgNameBox = cfgLeft:TextBox("Config Name", "my_config", nil, "cfg_name")

cfgLeft:Button("💾 Save Config", function()
    local name = cfgNameBox:Get()
    if name and name ~= "" then
        Lunex:SaveConfig(name)
        print("✅ Saved config:", name)
        refreshConfigs()
    end
end)

-- Config combo
local configs = Lunex:GetSavedConfigs() or {"none"}
local cfgCombo = cfgLeft:Combo("📂 Saved Configs", configs, 1, function(idx, name)
    if name and name ~= "none" then
        cfgNameBox:Set(name)
    end
end, "cfg_selected")

-- Refresh function
local function refreshConfigs()
    local newList = Lunex:GetSavedConfigs() or {"none"}
    if cfgCombo and cfgCombo.Refresh then
        cfgCombo:Refresh(newList)
        cfgCombo:Set(1, false)
    end
end

cfgLeft:Button("Load Config", function()
    local _, name = cfgCombo:Get()
    if name and name ~= "none" then
        Lunex:LoadConfig(name)
        print("✅ Loaded config:", name)
    else
        print("No config selected")
    end
end)

cfgLeft:Button("Delete Config", function()
    local _, name = cfgCombo:Get()
    if name and name ~= "none" then
        Lunex:DeleteConfig(name)
        print("Deleted config:", name)
        refreshConfigs()
    else
        print("No config selected")
    end
end)

cfgLeft:Button("Reset to Defaults", function()
    Lunex:ResetToDefaults()
    print("↻ Reset to defaults")
end)

cfgLeft:Button("Set Auto Load", function()
    local name = cfgNameBox:Get()
    if name and name ~= "" and name ~= "none" then
        Lunex:SetAutoLoad(name)
        print("Auto-load set to:", name)
    else
        print("Invalid config name")
    end
end)

-- ===== RIGHT GROUP: Themes =====
local cfgRight = cfg:Group("Theme Management", "right")

cfgRight:Combo(" Preset Theme", {"Default", "Tokyo Night", "Crimson", "Emerald"}, 1, function(idx, name)
    Lunex:SetPresetTheme(name)
    print(" Theme:", name)
end, "theme_preset")

local themeNameBox = cfgRight:TextBox("Theme File Name", "my_theme", nil, "theme_name")

-- Theme combo
local themes = Lunex:GetSavedThemes() or {"none"}
local themeCombo = cfgRight:Combo(" Saved Themes", themes, 1, function(idx, name)
    if name and name ~= "none" then
        themeNameBox:Set(name)
    end
end, "theme_saved")

local function refreshThemes()
    local newList = Lunex:GetSavedThemes() or {"none"}
    if themeCombo and themeCombo.Refresh then
        themeCombo:Refresh(newList)
        themeCombo:Set(1, false)
    end
end

cfgRight:Button(" Save Custom Theme", function()
    local name = themeNameBox:Get()
    if name and name ~= "" then
        Lunex:SaveTheme(name)
        print("✅ Saved theme:", name)
        refreshThemes()
    end
end)

cfgRight:Button(" Load Custom Theme", function()
    local _, name = themeCombo:Get()
    if name and name ~= "none" then
        Lunex:LoadTheme(name)
        print("✅ Loaded theme:", name)
    else
        print(" No theme selected")
    end
end)

cfgRight:Button(" Delete Custom Theme", function()
    local _, name = themeCombo:Get()
    if name and name ~= "none" then
        Lunex:DeleteTheme(name)
        print(" Deleted theme:", name)
        refreshThemes()
    else
        print(" No theme selected")
    end
end)

cfgRight:Button(" Reset Theme to Default", function()
    Lunex:ResetThemeToDefault()
    print("↻ Reset theme")
end)

