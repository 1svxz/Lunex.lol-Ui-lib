-- ============================================================
-- LUNEX UI LIBRARY - COMPLETE FEATURE DEMO
-- ============================================================

local Lunex = loadstring(game:HttpGet("https://raw.githubusercontent.com/1svxz/Lunex.lol-Ui-lib/main/Lunex.lua"))()

-- Create main window
local win = Lunex:Window({
    Size = Vector2.new(600, 550),
    TitleLeft = "My Script ",
    TitleRight = "v3.0"
})

-- ============================================================
-- TAB 1: MAIN
-- ============================================================
local main = win:Tab("Main")

-- ===== LEFT GROUP =====
local left = main:Group("General Settings", "left")

left:Checkbox("Enable Script", true, function(val)
    print("✅ Script enabled:", val)
end, nil, "script_enabled")

left:Checkbox("Auto Save", false, function(val)
    print("✅ Auto save:", val)
end, nil, "auto_save")

left:Slider("Sensitivity", {
    min = 0.1,
    max = 10.0,
    default = 1.0,
    decimals = 2,
    suffix = "x"
}, function(val)
    print("✅ Sensitivity:", val)
end, "sensitivity")

left:Slider("FOV", {
    min = 60,
    max = 120,
    default = 90,
    int = true,
    suffix = "°"
}, function(val)
    print("✅ FOV:", val)
end, "fov")

left:Combo("Game Mode", {"Normal", "Hard", "Expert", "Insane"}, 1, function(idx, text)
    print("✅ Mode:", text)
end, "game_mode")

left:MultiCombo("Enabled Features", {"Aimbot", "ESP", "Triggerbot", "Anti-AFK"}, {true, false, true, false}, function(states)
    print("✅ Features:", states)
end, "features")

-- ===== RIGHT GROUP =====
local right = main:Group("Advanced", "right")

right:TextBox("Player Name", "default", function(str)
    print("✅ Name:", str)
end, "player_name")

right:TextBox("Command", "", function(str)
    if str ~= "" then
        print("✅ Command executed:", str)
    end
end, "command")

right:Button("Execute Command", function()
    local cmd = Lunex.Controls.command:Get()
    if cmd and cmd ~= "" then
        print("✅ Executed:", cmd)
    else
        print("⚠️ No command entered")
    end
end)

right:Button("Print All Flags", function()
    print("\n📋 ALL FLAGS:")
    for k, v in pairs(Lunex.Flags) do
        if type(v) == "table" then
            print("  " .. k .. ": [table]")
        else
            print("  " .. k .. ": " .. tostring(v))
        end
    end
    print("")
end)

right:Keybind("Toggle Key", Enum.KeyCode.F, function(key)
    print("✅ Keybind:", key)
end, "toggle_key")

right:CheckboxKeybind("Fly Mode", false, Enum.KeyCode.G, function(state)
    print("✅ Fly mode:", state)
end, "fly_mode")

right:ColorPicker("Accent Color", Color3.fromRGB(200, 68, 240), function(col)
    Lunex.Theme.Accent = col
    Lunex.Theme.AccentDark = Color3.new(col.R * 0.7, col.G * 0.7, col.B * 0.7)
    Lunex:RefreshTheme()
    print("✅ Accent updated")
end, "custom_accent")

right:Label("────────────────────")
right:Label("This is a static label")
right:Label("No interaction possible")

