    [Enum.KeyCode.Tab]        = "Tab",   [Enum.KeyCode.Backspace]   = "Back",
    [Enum.KeyCode.CapsLock]   = "Caps",  [Enum.KeyCode.Escape]      = "Esc",
    [Enum.KeyCode.Insert]     = "Insert",[Enum.KeyCode.Delete]      = "Del",
    [Enum.KeyCode.Up]="Up", [Enum.KeyCode.Down]="Down",
