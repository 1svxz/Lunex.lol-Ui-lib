function Library:Watermark(params)
    local Cfg = { Name = params.Name or "Watermark", Modules = params.Modules or {}, Items = {} }
    local Items = Cfg.Items

    Items['Container'] = new_instance("Frame", {
        Parent = Library.Extras or screen_gui,
        Name = "Watermark",
        Position = UDim2.fromOffset(10, 10),
        Size = UDim2.fromOffset(0, 26),
        AutomaticSize = Enum.AutomaticSize.X,
        BackgroundColor3 = Color3.new(1,1,1),
        BorderSizePixel = 0,
        ZIndex = 200,
    })
    local bg = new_instance("Frame", { BackgroundColor3 = Library.Theme.PanelFill, BorderSizePixel = 0, Size = UDim2.fromScale(1,1) }, Items['Container'])
    Library:RegisterTheme(bg, "BackgroundColor3", "PanelFill")
    local out = new_instance("UIStroke", { Color = Library.Theme.OuterBorder, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, Items['Container'])
    Library:RegisterTheme(out, "Color", "OuterBorder")
    local inn = new_instance("UIStroke", { Color = Library.Theme.InnerBorder, Thickness = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border, BorderStrokePosition = Enum.BorderStrokePosition.Inner }, Items['Container'])
    Library:RegisterTheme(inn, "Color", "InnerBorder")

    local inner = new_instance("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4) }, Items['Container'])
    new_instance("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 2), SortOrder = Enum.SortOrder.LayoutOrder }, inner)

    local nameLabel = make_label(inner, Cfg.Name, "TextActive", { Size = UDim2.fromOffset(0, 12), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 2 })
    local sep = make_label(inner, " | ", "TextInactive", { Size = UDim2.fromOffset(0, 12), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 2 })

    local Labels = {}
    for _, module in ipairs(Cfg.Modules) do
        local lbl = make_label(inner, "", "TextInactive", { Size = UDim2.fromOffset(0, 12), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 2 })
        table.insert(Labels, lbl)
        if _ < #Cfg.Modules then
            make_label(inner, " | ", "TextInactive", { Size = UDim2.fromOffset(0, 12), AutomaticSize = Enum.AutomaticSize.X, ZIndex = 2 })
        end
    end

    Library:Draggify(Items['Container'])

    local function resolve(module)
        if module.Type == "Text" then return module.Value or ""
        elseif module.Type == "Fps" then return "FPS: " .. tostring(CurrentFps)
        elseif module.Type == "Ping" then
            local ping = 0
            local stats = Stats:FindFirstChild("Network")
            if stats and stats:FindFirstChild("ServerStatsItem") then
                local p = stats.ServerStatsItem:FindFirstChild("Data Ping")
                if p then ping = math.floor(p:GetValue()) end
            end
            return "Ping: " .. ping .. "ms"
        elseif module.Type == "Time" then return os.date("%H:%M:%S")
        elseif module.Type == "Custom" then return module.Value or ""
        end
        return ""
    end

    local CurrentFps = 0
    local frames = 0
    local last = tick()
    RunService.RenderStepped:Connect(function()
        frames = frames + 1
        local now = tick()
        if now - last >= 1 then CurrentFps = frames; frames = 0; last = now end
    end)

    task.spawn(function()
        while task.wait(0.2) do
            for i, module in ipairs(Cfg.Modules) do
                if Labels[i] then Labels[i].Text = resolve(module) end
            end
            local total = 0
            for _, child in ipairs(inner:GetChildren()) do
                if child:IsA("TextLabel") then total = total + child.TextBounds.X + 2 end
            end
            Items['Container'].Size = UDim2.fromOffset(total + 16, 26)
        end
    end)

    return Cfg
end

