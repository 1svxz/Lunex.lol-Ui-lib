-- Slider with ± buttons (matches screenshot)
function Library._GroupMethods:Slider(text, options, callback, flag)
    options = options or {}
    local minv = options.min or 0
    local maxv = options.max or 1
    local decimals = options.decimals or 3
    local isInt = options.int and true or false
    local suffix = options.suffix or ""
    local value = options.default or minv
    local step = options.step or 1

    local row = nextRow(self, 28)
    local label = makeLabel(row, text, "TextInactive", {
        Position = UDim2.fromOffset(1, 0),
        Size = UDim2.fromOffset(120, 13),
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 3,
    })
    local valLabel = makeLabel(row, "", "TextInactive", {
        Position = UDim2.new(1, -120, 0, 0),
        Size = UDim2.fromOffset(120, 13),
        TextXAlignment = Enum.TextXAlignment.Right,
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 3,
    })

    -- Buttons for increment/decrement (matching screenshot)
    local btnContainer = newInstance("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -26, 0, 16),
        Size = UDim2.fromOffset(24, 12),
        ZIndex = 3,
    }, row)
    newInstance("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 2),
    }, btnContainer)

    local minusBtn = newInstance("TextButton", {
        Text = "−",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(10, 12),
        TextColor3 = Library.Theme.TextInactive,
        TextSize = 12,
        ZIndex = 3,
    }, btnContainer)
    local plusBtn = newInstance("TextButton", {
        Text = "+",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Size = UDim2.fromOffset(10, 12),
        TextColor3 = Library.Theme.TextInactive,
        TextSize = 12,
        ZIndex = 3,
    }, btnContainer)

    local track = newInstance("TextButton", {
        Text = "",
        AutoButtonColor = false,
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 16),
        Size = UDim2.new(1, -30, 0, 12),
        ZIndex = 3,
    }, row)
    local _, tFill = framedBox(track, "OuterBorder", "InnerBorder", "ChildFill", { ZIndex = 3 })
    local progress = newInstance("Frame", {
        BackgroundColor3 = Library.Theme.Accent,
        BorderSizePixel = 0,
        Size = UDim2.fromScale(0, 1),
        ZIndex = 3,
    }, tFill)
    verticalGradient(progress, "Accent", "AccentDark")

    local function format(v)
        if isInt then return string.format("%d%s", v, suffix) end
        return string.format("%."..decimals.."f%s", v, suffix)
    end

    local function render()
        local t = (maxv > minv) and (value - minv) / (maxv - minv) or 0
        progress.Size = UDim2.fromScale(math.clamp(t, 0, 1), 1)
        valLabel.Text = format(value)
    end

    local function set(v, fireCallback)
        v = math.clamp(v, minv, maxv)
        if isInt then v = math.floor(v + 0.5) end
        value = v
        render()
        if flag then Library.Flags[flag] = value end
        if fireCallback ~= false and callback then
            task.spawn(callback, value)
        end
    end

    minusBtn.MouseButton1Click:Connect(function()
        set(value - step, true)
    end)
    plusBtn.MouseButton1Click:Connect(function()
        set(value + step, true)
    end)

    local dragging = false
    local function fromInput(input)
        local inputX = input.Position.X
        local rel = (inputX - tFill.AbsolutePosition.X) / tFill.AbsoluteSize.X
        set(minv + math.clamp(rel, 0, 1) * (maxv - minv), true)
    end

    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            fromInput(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            fromInput(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    render()
    local ctrl = {
        Set = function(_, v, f) set(v, f) end,
        Get = function() return value end,
    }
    if flag then
        Library.Flags[flag] = value
        Library.Controls[flag] = ctrl
        Library.Defaults[flag] = value
    end
    if callback and options.default ~= nil then
        task.spawn(callback, value)
    end
    return ctrl
end

