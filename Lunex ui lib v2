        Position = UDim2.fromOffset(1, 0),
        Size = UDim2.fromOffset(120, 13),
        TextYAlignment = Enum.TextYAlignment.Top,
        ZIndex = 3,
    })

    local box_frame = new_instance("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 16),
        Size = UDim2.new(1, 0, 0, 18),
        ZIndex = 3,
    }, row)
    local _, b_fill = framed_box(box_frame, "OuterBorder", "ComboInner", "ComboFill", { ZIndex = 3 })
    local tb = new_instance("TextBox", {
        BackgroundTransparency = 1,
        Text = Cfg.Default,
        TextColor3 = Library.Theme.TextActive,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        Position = UDim2.fromOffset(5, 0),
        Size = UDim2.new(1, -10, 1, 0),
        ClearTextOnFocus = false,
        ZIndex = 4,
        PlaceholderText = Cfg.Placeholder,
        PlaceholderColor3 = Library.Theme.TextInactive,
    }, b_fill)
    apply_font(tb, false)
    Library:RegisterTheme(tb, "TextColor3", "TextActive")
    Library:RegisterTheme(tb, "PlaceholderColor3", "TextInactive")

    tb.Focused:Connect(function() Library.InputFocused = true end)
    tb.FocusLost:Connect(function(enter)
        Library.InputFocused = false
        if enter then
            if Cfg.Flag then Library.Flags[Cfg.Flag] = tb.Text end
            Cfg.Callback(tb.Text)
        end
    end)

    local ctrl = {
        Set = function(_, str) tb.Text = str; if Cfg.Flag then Library.Flags[Cfg.Flag] = str end; Cfg.Callback(str) end,
        Get = function() return tb.Text end,
    }
    if Cfg.Flag then
        Library.Flags[Cfg.Flag] = Cfg.Default
        Library.Controls[Cfg.Flag] = ctrl
        Library.Defaults[Cfg.Flag] = Cfg.Default
    end
    return ctrl
end

