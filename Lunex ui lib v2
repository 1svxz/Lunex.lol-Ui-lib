local function keyText(k)
    if k == nil then return "None" end
    if KEY_NAMES[k] then return KEY_NAMES[k] end
    if typeof(k) == "EnumItem" and k.EnumType == Enum.KeyCode then
        return k.Name
    end
    return "?"
end

