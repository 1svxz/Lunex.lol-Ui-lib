    [Enum.UserInputType.MouseButton1] = "LM",
    [Enum.UserInputType.MouseButton2] = "RM",
    [Enum.UserInputType.MouseButton3] = "MM",
    [Enum.KeyCode.LeftShift]  = "Shift", [Enum.KeyCode.RightShift]  = "Shift",
