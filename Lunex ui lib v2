        local btn = new_instance("TextButton", {
            Parent = header,
            Text = "",
            AutoButtonColor = false,
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(0, 18),
            AutomaticSize = Enum.AutomaticSize.X,
            ZIndex = 4,
        })
        local label = make_label(btn, name, "TabInactive", {
            Size = UDim2.new(1, -8, 1, 0),
            TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 5,
        })
        btn.Size = UDim2.fromOffset(label.TextBounds.X + 8, 18)
        tabButtons[i] = {btn = btn, label = label}

        local page = new_instance("Frame", {
            Parent = pages,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, -8, 1, -8),
            Position = UDim2.fromOffset(4, 4),
            Visible = (i == 1),
            ZIndex = 3,
            ClipsDescendants = false,
        })
        new_instance("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, page)
        tabPages[i] = page

        btn.MouseButton1Click:Connect(function()
            for j, tb in ipairs(tabButtons) do
                local active = (j == i)
                tb.label.TextColor3 = active and Library.Theme.Accent or Library.Theme.TabInactive
                tabPages[j].Visible = active
            end
        end)
        btn.MouseEnter:Connect(function()
            if i ~= Cfg.ActiveIndex then
                tween(label, 0.12, { TextColor3 = Library.Theme.TabHover }):Play()
            end
        end)
        btn.MouseLeave:Connect(function()
            if i ~= Cfg.ActiveIndex then
                tween(label, 0.12, { TextColor3 = Library.Theme.TabInactive }):Play()
            end
        end)
    end

    Cfg.ActiveIndex = 1
    tabButtons[1].label.TextColor3 = Library.Theme.Accent

    local subSection = {}
    function subSection:Tab(index)
        if index < 1 or index > Cfg.Count then error("Invalid tab index") end
        local page = tabPages[index]
        local group = setmetatable({
            Content = page,
            _order = 0,
            _update_size = function() end,
        }, {__index = Library._GroupMethods})
        function group:next_row(height)
            self._order = self._order + 1
            local row = new_instance("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, height),
                LayoutOrder = self._order,
                ZIndex = 3,
            }, self.Content)
            return row
        end
        return group
    end
    return subSection
end

