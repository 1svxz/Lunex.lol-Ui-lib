-- TabGroup (max 2 tabs)
function Library._GroupMethods:TabGroup(tabs, defaultTab, options)
    options = options or {}
    local maxTabs = 2
    if #tabs > maxTabs then error("TabGroup supports at most " .. maxTabs .. " tabs") end
    local active = defaultTab or 1

    local row = next_row(self, 30)
    local host = new_instance("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 30),
        ZIndex = 3,
    }, row)

    local tabButtons = {}
    local tabContents = {}
    local tabWidth = 100
    local gap = 2

    for i, name in ipairs(tabs) do
        local btn = new_instance("TextButton", {
            Text = "", AutoButtonColor = false, BackgroundTransparency = 1,
            Position = UDim2.fromOffset((i-1)*(tabWidth+gap), 0),
            Size = UDim2.fromOffset(tabWidth, 16),
            ZIndex = 4,
        }, host)
        local _, fill = framed_box(btn, "OuterBorder", "InnerBorder", "ChildFill", { ZIndex = 4 })
        local label = make_label(btn, name, "TextInactive", {
            Size = UDim2.fromScale(1,1),
            TextXAlignment = Enum.TextXAlignment.Center,
            ZIndex = 5,
        })
        tabButtons[i] = {btn = btn, fill = fill, label = label}

        local contentFrame = new_instance("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(0, 18),
            Size = UDim2.new(1, 0, 1, -18),
            ZIndex = 3,
            Visible = (i == active),
            ClipsDescendants = false,
        }, host)
        new_instance("UIListLayout", {
            FillDirection = Enum.FillDirection.Vertical,
            Padding = UDim.new(0, 4),
            SortOrder = Enum.SortOrder.LayoutOrder,
        }, contentFrame)
        tabContents[i] = contentFrame
    end

    local function select(idx)
        for i = 1, #tabs do
            local active_ = (i == idx)
            tabContents[i].Visible = active_
            tabButtons[i].label.TextColor3 = active_ and Library.Theme.Accent or Library.Theme.TabInactive
            tween(tabButtons[i].label, 0.12, { TextColor3 = active_ and Library.Theme.Accent or Library.Theme.TabInactive }):Play()
        end
        active = idx
    end

    for i, btnData in ipairs(tabButtons) do
        btnData.btn.MouseButton1Click:Connect(function() select(i) end)
        btnData.btn.MouseEnter:Connect(function()
            if active ~= i then tween(btnData.label, 0.12, { TextColor3 = Library.Theme.TabHover }):Play() end
        end)
        btnData.btn.MouseLeave:Connect(function()
            if active ~= i then tween(btnData.label, 0.12, { TextColor3 = Library.Theme.TabInactive }):Play() end
        end)
    end

    local tabGroup = {}
    function tabGroup:Tab(index)
        if index < 1 or index > #tabs then error("Invalid tab index") end
        local content = tabContents[index]
        local subGroup = setmetatable({
            Content = content,
            _order = 0,
            _update_size = function() end,
        }, {__index = Library._GroupMethods})
        function subGroup:next_row(height)
            self._order = self._order + 1
            local row = new_instance("Frame", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, height),
                LayoutOrder = self._order,
                ZIndex = 3,
            }, self.Content)
            return row
        end
        return subGroup
    end

    select(active)
    return tabGroup
end

