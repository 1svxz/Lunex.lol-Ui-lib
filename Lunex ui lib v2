        dummy.Size = Vector3.new(2, 4, 1)
        dummy.BrickColor = BrickColor.new("Bright blue")
        dummy.Anchored = true
        dummy.Parent = vp
        local dummy2 = dummy:Clone()
        dummy2.Position = Vector3.new(3, 0, 2)
        dummy2.BrickColor = BrickColor.new("Bright red")
        dummy2.Parent = vp
        local dummy3 = dummy:Clone()
        dummy3.Position = Vector3.new(-3, 0, -2)
        dummy3.BrickColor = BrickColor.new("Bright green")
        dummy3.Parent = vp

        local angle = 0
        local conn
        conn = RunService.RenderStepped:Connect(function(dt)
            if not vp.Parent then conn:Disconnect() return end
            angle = angle + dt * 0.5
            vp.CurrentCamera.CFrame = CFrame.new(0, 2, 8) * CFrame.Angles(0, angle, 0)
        end)

        window._espContainer = vp
        window.SetESPRenderer = function(_, renderFn)
            if renderFn then
                conn:Disconnect()
                renderFn(vp)
            end
        end
    end

    if tabs_config.info ~= false then
        info_tab = window:Tab("Info / Logs")
        local info_group = info_tab:Group("Change Logs", "left")
        for _, log in ipairs(Library.ChangeLogs) do
            info_group:Label("• " .. log)
        end
        info_group:Label("")
        info_group:Label("Lunex UI Library v2")
        info_group:Label("https://github.com/1svxz/Lunex.lol-Ui-lib")
    end

    window._mainTab = main_tab
    window._espTab = esp_tab
    window._infoTab = info_tab

    function window:GetTab(name)
        for _, tab in ipairs(self.Tabs) do
            if tab.Name == name then return tab end
        end
        return nil
    end

    if #window.Tabs > 0 then
        window.Tabs[1]:Select()
    end

    return window
end

