    local function border(pos, size, colorKey)
        local f = newInstance("Frame", {
            BackgroundColor3 = Library.Theme[colorKey],
            BorderSizePixel = 0,
            Position = pos,
            Size = size,
            ZIndex = 2,
        }, panel)
        Library:RegisterTheme(f, "BackgroundColor3", colorKey)
        return f
    end
    border(UDim2.fromOffset(0,0), UDim2.fromOffset(1,1), "ContentOuter")
    border(UDim2.new(1,-1,0,0), UDim2.fromOffset(1,1), "ContentOuter")
    border(UDim2.fromOffset(0,1,1,-1), UDim2.new(1,0,0,1), "ContentOuter")
    border(UDim2.fromOffset(0,0), UDim2.new(1,0,0,1), "ContentOuter")
    border(UDim2.fromOffset(0,0), UDim2.fromOffset(0,1), "ContentOuter")
    -- inner
    border(UDim2.fromOffset(1,1), UDim2.new(0,1,1,-2), "ContentInner")
    border(UDim2.new(1,-2,0,1), UDim2.new(0,1,1,-2), "ContentInner")
    border(UDim2.fromOffset(0,1,1,-2), UDim2.new(1,-2,0,1), "ContentInner")
    border(UDim2.fromOffset(1,1), UDim2.new(1,-2,0,1), "ContentInner")
    border(UDim2.fromOffset(1,1), UDim2.fromOffset(0,1), "ContentInner")

    -- Tabs (matching screenshot: Settings, Preview, Keybinds, etc.)
    local TAB_W, TAB_H, TAB_SP = 81, 18, 2
    local tabHost = newInstance("Frame", {
        Name = "Tabs",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(10, 40 - TAB_H),
        Size = UDim2.fromOffset(0, TAB_H),
        ZIndex = 4,
    }, canvas)

    local pageHost = newInstance("Frame", {
        Name = "Pages",
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(18, 48),
        Size = UDim2.new(1, -36, 1, -66),
        ZIndex = 3,
        ClipsDescendants = true,
    }, canvas)

    -- Drag zone
    local dragZone = newInstance("TextButton", {
        Name = "DragZone",
        BackgroundTransparency = 1,
        Text = "",
        Position = UDim2.fromScale(0,0),
        Size = UDim2.fromScale(1,1),
        ZIndex = 2,
        AutoButtonColor = false,
    }, canvas)

    local dragging, dragStart, dragInputStart = false, nil, nil
    dragZone.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = canvas.Position
            dragInputStart = Vector2.new(input.Position.X, input.Position.Y)
            closeAllPopups()
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = Vector2.new(input.Position.X, input.Position.Y) - dragInputStart
            canvas.Position = UDim2.new(
                dragStart.X.Scale, dragStart.X.Offset + delta.X,
                dragStart.Y.Scale, dragStart.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    -- Resize handles (PC only, optional)
    if not Library.MobileEnabled then
        local T = 8
        local host = newInstance("Frame", {
            Name = "ResizeHost",
            BackgroundTransparency = 1,
            Active = false,
            Position = canvas.Position,
            Size = canvas.Size,
            ZIndex = 60,
        }, canvas.Parent)
        local function syncHost()
            host.Position = canvas.Position
            host.Size = canvas.Size
            host.Visible = canvas.Visible
        end
        canvas:GetPropertyChangedSignal("Position"):Connect(syncHost)
        canvas:GetPropertyChangedSignal("Size"):Connect(syncHost)
        canvas:GetPropertyChangedSignal("Visible"):Connect(syncHost)
        syncHost()
        local edges = {
            {n="SE", p=UDim2.new(1,-T,1,-T), s=UDim2.fromOffset(T*2,T*2), sx=1, sy=1},
        }
        for _, e in ipairs(edges) do
            local handle = newInstance("TextButton", {
                Name = "Resize"..e.n,
                Text = "",
                AutoButtonColor = false,
                BackgroundTransparency = 1,
                Position = e.p,
                Size = e.s,
                ZIndex = 60,
            }, host)
            local active, startSize, startPos, startInput = false, nil, nil, nil
            handle.InputBegan:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    active = true
                    startSize = Vector2.new(canvas.Size.X.Offset, canvas.Size.Y.Offset)
                    startPos = canvas.Position
                    startInput = Vector2.new(input.Position.X, input.Position.Y)
                    closeAllPopups()
                end
            end)
            UserInputService.InputChanged:Connect(function(input)
                if not active or input.UserInputType ~= Enum.UserInputType.MouseMovement then return end
                local delta = Vector2.new(input.Position.X, input.Position.Y) - startInput
                local minW = 360
                local w = math.clamp(startSize.X + e.sx * delta.X, minW, 800)
                local h = math.clamp(startSize.Y + e.sy * delta.Y, 360, 800)
                canvas.Size = UDim2.fromOffset(w, h)
                canvas.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset,
                    startPos.Y.Scale, startPos.Y.Offset
                )
            end)
            UserInputService.InputEnded:Connect(function(input)
                if input.UserInputType == Enum.UserInputType.MouseButton1 then
                    active = false
                end
            end)
        end
    end

    local window = setmetatable({
        Canvas   = canvas,
        TabHost  = tabHost,
        PageHost = pageHost,
        Tabs     = {},
        ActiveTab= nil,
        _tabW    = TAB_W,
        _tabH    = TAB_H,
        _tabSp   = TAB_SP,
    }, {__index = Library._WindowMethods})

    local function updateTabPositions()
        local tabs = window.Tabs
        local count = #tabs
        if count == 0 then return end
        local panelW = canvas.Size.X.Offset - 20
        local sp = window._tabSp or 2
        local w = window._tabW or 81
        local total = count * w + (count-1) * sp
        window._tabsTotal = total
        tabHost.Size = UDim2.fromOffset(total, window._tabH)
        tabHost.Position = UDim2.fromOffset(
            10 + math.floor((panelW - total) / 2),
            40 - window._tabH
        )
        for i, tab in ipairs(tabs) do
            local x = (i-1) * (w + sp)
            tab.Button.Position = UDim2.fromOffset(x, 0)
            tab.Button.Size = UDim2.fromOffset(w, window._tabH)
        end
    end

    -- store refs
    window._oT1 = border(UDim2.fromOffset(0,0), UDim2.fromOffset(0,1), "ContentOuter")
    window._oT2 = border(UDim2.fromOffset(0,0), UDim2.fromOffset(0,1), "ContentOuter")
    window._iT1 = border(UDim2.fromOffset(0,0), UDim2.fromOffset(0,1), "ContentInner")
    window._iT2 = border(UDim2.fromOffset(0,0), UDim2.fromOffset(0,1), "ContentInner")

