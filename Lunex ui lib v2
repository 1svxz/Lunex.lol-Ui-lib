Library._GroupMethods = {}

local function next_row(group, height)
    group._order = group._order + 1
    local row = new_instance("Frame", {
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, height),
        LayoutOrder = group._order,
        ZIndex = 3,
