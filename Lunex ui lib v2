-- Utilities
local function newInstance(class, props, parent)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do
        if k ~= "Parent" then obj[k] = v end
    end
    if parent then obj.Parent = parent end
    return obj
end

local function applyFont(label, bold)
    label.Font = bold and Enum.Font.SourceSansBold or Enum.Font.SourceSans
end

local function makeLabel(parent, text, colorKey, props)
    local color = type(colorKey) == "string" and Library.Theme[colorKey] or colorKey
    local lbl = newInstance("TextLabel", {
        BackgroundTransparency = 1,
        Text                   = text or "",
        TextColor3             = color or Library.Theme.TextActive,
        TextSize               = 13,
        TextXAlignment         = Enum.TextXAlignment.Left,
        TextYAlignment         = Enum.TextYAlignment.Center,
        TextStrokeColor3       = Library.Theme.OuterBorder,
        TextStrokeTransparency = 0.6,
        TextTruncate           = Enum.TextTruncate.AtEnd,
        RichText               = false,
        ZIndex                 = 5,
    }, parent)
    applyFont(lbl, props and props.Bold)
    if type(colorKey) == "string" then
        Library:RegisterTheme(lbl, "TextColor3", colorKey)
    end
    Library:RegisterTheme(lbl, "TextStrokeColor3", "OuterBorder")
    if props then
        for k, v in pairs(props) do
            if k ~= "Bold" then lbl[k] = v end
        end
    end
    return lbl
end

local function framedBox(parent, outerKey, innerKey, fillKey, props)
    local outer = newInstance("Frame", {
        BackgroundColor3 = type(outerKey)=="string" and Library.Theme[outerKey] or outerKey,
        BorderSizePixel  = 0,
        Size             = UDim2.fromScale(1, 1),
    }, parent)
    if type(outerKey) == "string" then
        Library:RegisterTheme(outer, "BackgroundColor3", outerKey)
    end
    if props then for k,v in pairs(props) do outer[k] = v end end

    local inner = newInstance("Frame", {
        BackgroundColor3 = type(innerKey)=="string" and Library.Theme[innerKey] or innerKey,
        BorderSizePixel  = 0,
        Position         = UDim2.fromOffset(1, 1),
        Size             = UDim2.new(1, -2, 1, -2),
        ZIndex           = outer.ZIndex or 1,
    }, outer)
    if type(innerKey) == "string" then
        Library:RegisterTheme(inner, "BackgroundColor3", innerKey)
    end

    local fill = newInstance("Frame", {
        Name             = "Fill",
        BackgroundColor3 = type(fillKey)=="string" and Library.Theme[fillKey] or fillKey,
        BorderSizePixel  = 0,
        Position         = UDim2.fromOffset(2, 2),
        Size             = UDim2.new(1, -4, 1, -4),
        ZIndex           = outer.ZIndex or 1,
    }, outer)
    if type(fillKey) == "string" then
        Library:RegisterTheme(fill, "BackgroundColor3", fillKey)
    end
    return outer, fill
end

local function verticalGradient(frame, topKey, bottomKey)
    frame.BackgroundColor3 = Color3.new(1,1,1)
    local grad = newInstance("UIGradient", {
        Rotation = 90,
        Transparency = NumberSequence.new(0),
    }, frame)
    local function update()
        local top = type(topKey)=="string" and Library.Theme[topKey] or topKey
        local bot = type(bottomKey)=="string" and Library.Theme[bottomKey] or bottomKey
        grad.Color = ColorSequence.new(top, bot)
    end
    update()
    Library:RegisterThemeCallback(update)
    return grad
end

local function tween(obj, duration, goal)
    return TweenService:Create(obj, TweenInfo.new(duration or 0.12, Enum.EasingStyle.Quad), goal)
end

-- Theme registration
Library.ThemeRegistry = {}
Library.ThemeCallbacks = {}
Library.ThemePickers = {}

function Library:RegisterTheme(inst, prop, key)
    if not inst then return end
    table.insert(self.ThemeRegistry, {Inst = inst, Prop = prop, Key = key})
    if self.Theme and self.Theme[key] then
        inst[prop] = self.Theme[key]
    end
end

function Library:RegisterThemeCallback(fn)
    table.insert(self.ThemeCallbacks, fn)
    pcall(fn)
end

function Library:RefreshTheme()
    for i = #self.ThemeRegistry, 1, -1 do
        local item = self.ThemeRegistry[i]
        if item.Inst and item.Inst.Parent then
            if self.Theme[item.Key] then
                item.Inst[item.Prop] = self.Theme[item.Key]
            end
        else
            table.remove(self.ThemeRegistry, i)
        end
    end
    for _, cb in ipairs(self.ThemeCallbacks) do
        pcall(cb)
    end
    for _, picker in pairs(self.ThemePickers) do
        if picker and picker.Set and self.Theme[picker._key] then
            picker:Set(self.Theme[picker._key], false)
        end
    end
end

