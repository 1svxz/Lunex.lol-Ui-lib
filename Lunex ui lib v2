-- Mobile toggle button
local mobileToggle = nil
function Library:CreateMobileToggle(onToggle)
    if not self.MobileEnabled then return end
    if mobileToggle then return end
    local icon = newInstance("ImageButton", {
        Name = "MobileToggle",
        Image = "rbxassetid://6031090839",
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, -50, 0.5, 0),
        Size = UDim2.fromOffset(40, 40),
        ZIndex = 600,
        AutoButtonColor = false,
    }, screenGui)
    local dragData = { dragging = false, startPos = nil, startInput = nil, moved = false }
    icon.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.Touch then
            dragData.dragging = true
            dragData.startPos = icon.Position
            dragData.startInput = Vector2.new(input.Position.X, input.Position.Y)
            dragData.moved = false
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragData.dragging and input.UserInputType == Enum.UserInputType.Touch then
            local delta = Vector2.new(input.Position.X, input.Position.Y) - dragData.startInput
            if delta.Magnitude > 5 then dragData.moved = true end
            icon.Position = UDim2.new(
                dragData.startPos.X.Scale, dragData.startPos.X.Offset + delta.X,
                dragData.startPos.Y.Scale, dragData.startPos.Y.Offset + delta.Y
            )
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if dragData.dragging and input.UserInputType == Enum.UserInputType.Touch then
            if not dragData.moved and onToggle then onToggle() end
            dragData.dragging = false
        end
    end)
    mobileToggle = icon
    return icon
end

-- Config & Theme helpers (keep from original, simplified)
local function getConfigsPath() return Library.Folder .. "/Configs" end
local function getThemesPath() return Library.Folder .. "/Themes" end
local function ensureFolders()
    if makefolder and isfolder then
        pcall(makefolder, Library.Folder)
        pcall(makefolder, getConfigsPath())
        pcall(makefolder, getThemesPath())
    end
end
ensureFolders()

local function serialize(val)
    if typeof(val) == "Color3" then
        return {__type = "Color3", r = val.R, g = val.G, b = val.B}
    elseif typeof(val) == "EnumItem" then
        return {__type = "EnumItem", enumType = tostring(val.EnumType), name = val.Name}
    end
    return val
end
local function deserialize(val)
    if type(val) == "table" and val.__type then
        if val.__type == "Color3" then
            return Color3.new(val.r, val.g, val.b)
        elseif val.__type == "EnumItem" then
            local enumGroup = Enum[val.enumType]
            if enumGroup and enumGroup[val.name] then
                return enumGroup[val.name]
            end
        end
    end
    return val
end

function Library:SaveConfig(filename)
    if not writefile then return end
    ensureFolders()
    filename = filename or "default"
    local path = getConfigsPath() .. "/" .. filename .. ".json"
    local data = {}
    for flag, val in pairs(self.Flags) do
        if type(val) == "table" and not val.__type then
            local tbl = {}
            for k, v in pairs(val) do tbl[k] = serialize(v) end
            data[flag] = tbl
        else
            data[flag] = serialize(val)
        end
    end
    pcall(writefile, path, HttpService:JSONEncode(data))
end

function Library:LoadConfig(filename)
    if not readfile or not isfile then return end
    filename = filename or "default"
    local path = getConfigsPath() .. "/" .. filename .. ".json"
    if not isfile(path) then return end
    local ok, content = pcall(readfile, path)
    if not ok then return end
    local ok2, decoded = pcall(function() return HttpService:JSONDecode(content) end)
    if not ok2 or type(decoded) ~= "table" then return end
    for flag, val in pairs(decoded) do
        local final
        if type(val) == "table" and not val.__type then
            final = {}
            for k, v in pairs(val) do final[k] = deserialize(v) end
        else
            final = deserialize(val)
        end
        self.Flags[flag] = final
        if self.Controls[flag] and self.Controls[flag].Set then
            self.Controls[flag]:Set(final, true)
        end
    end
    self:RefreshTheme()
end

function Library:DeleteConfig(filename)
    if not delfile or not isfile then return end
    filename = filename or "default"
    local path = getConfigsPath() .. "/" .. filename .. ".json"
    if isfile(path) then pcall(delfile, path) end
end

function Library:ResetToDefaults()
    for flag, defaultVal in pairs(self.Defaults) do
        self.Flags[flag] = deepCopy(defaultVal)
        if self.Controls[flag] and self.Controls[flag].Set then
            self.Controls[flag]:Set(deepCopy(defaultVal), true)
        end
    end
end

function Library:SetPresetTheme(name)
    if self.Presets[name] then
        for k, v in pairs(self.Presets[name]) do
            self.Theme[k] = v
        end
        self:RefreshTheme()
    end
end

