function Library:CreateConfigManager(tab, side)
    local group = tab:Group("Config Manager", side or "left")
    local config_combo
    local name_box = group:Textbox({ Name = "Config Name", Default = "my_config", Callback = function() end, Flag = "_cfg_name" })

    local function refresh_dropdown()
        local list = scan_config_files()
        if #list == 0 then list = {"none"} end
        if config_combo and config_combo.Refresh then
            config_combo:Refresh(list)
            config_combo:Set(1, false)
        end
    end

    config_combo = group:Dropdown({ Name = "Saved Configs", Options = scan_config_files(), Default = "none", Callback = function(idx, name)
        if name and name ~= "none" then name_box:Set(name) end
    end, Flag = "_cfg_combo" })

