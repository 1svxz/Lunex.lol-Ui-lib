    newInstance("UIPadding", { PaddingRight = UDim.new(0, 4) }, rightCol)
    newInstance("UIListLayout", {
        FillDirection = Enum.FillDirection.Vertical,
        Padding = UDim.new(0, 6),
        SortOrder = Enum.SortOrder.LayoutOrder,
    }, rightCol)

