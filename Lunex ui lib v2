    content.ChildRemoved:Connect(function() task.defer(updateSize) end)
    task.defer(updateSize)

    local group = setmetatable({
        Tab = tab,
        Content = content,
        _order = 0,
        _updateSize = updateSize,
    }, {__index = Library._GroupMethods})
    return group
