-- Window toggle
function Library:BindToggle(window)
    local visible = true
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == Library.ToggleKey then
            visible = not visible
            closeAllPopups()
            if visible then
                window.Canvas.Visible = true
                tween(window.Canvas, 0.3, { GroupTransparency = 0 }):Play()
            else
                tween(window.Canvas, 0.3, { GroupTransparency = 1 }):Play()
                task.delay(0.3, function()
                    if not visible then window.Canvas.Visible = false end
                end)
            end
        end
    end)
end

-- Auto-load check
Library:CheckAutoLoad = function() end -- stub

return Library
